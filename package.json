{
    "name": "jrvalerio-dev",
    "version": "1.0.0",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "analyze": "cross-env ANALYZE=true next build",
        "check:bundle": "node scripts/check-bundle.js",
        "check:bundle:case": "cross-env BUNDLE_ROUTE=/v2/projetos/ecovoz BUNDLE_LIMIT_KB=240 node scripts/check-bundle.js",
        "check:bundle:projetos": "cross-env BUNDLE_ROUTE=/v2/projetos BUNDLE_LIMIT_KB=235 node scripts/check-bundle.js",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@testing-library/dom": "^10.4.1",
        "@vercel/analytics": "^1.6.1",
        "cmdk": "^1.1.1",
        "fuse.js": "^7.1.0",
        "gray-matter": "^4.0.3",
        "lucide-react": "^0.577.0",
        "motion": "^12.40.0",
        "next": "^16.4.6",
        "next-themes": "^0.4.6",
        "posthog-js": "^1.359.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "reactflow": "^11.11.4",
        "resend": "^6.12.4",
        "three": "^0.187.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@lhci/cli": "^0.16.1",
        "@next/bundle-analyzer": "^16.4.6",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/postcss": "^4.1.11",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^4.0.18",
        "autoprefixer": "^10.4.21",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.4.6",
        "fast-check": "^4.10.3",
        "happy-dom": "^21.0.4",
        "postcss": "^8.5.33",
        "tailwindcss": "^4.1.11",
        "typescript": "^5.9.3",
        "vitest": "^4.0.18"
    }
}
