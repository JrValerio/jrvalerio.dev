{
    "name": "jrvalerio-dev",
    "version": "1.0.0",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "analyze": "cross-env ANALYZE=true next build",
        "check:bundle": "node scripts/check-bundle.js",
        "check:bundle:case": "cross-env BUNDLE_ROUTE=/v2/projetos/[slug]/page BUNDLE_LIMIT_KB=120 node scripts/check-bundle.js",
        "check:bundle:projetos": "cross-env BUNDLE_ROUTE=/v2/projetos/page BUNDLE_LIMIT_KB=163 node scripts/check-bundle.js",
        "start": "next start",
        "lint": "next lint",
        "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@emailjs/browser": "^4.4.1",
        "@react-three/drei": "^10.7.7",
        "@react-three/fiber": "^9.5.0",
        "@testing-library/dom": "^10.4.1",
        "@vercel/analytics": "^1.6.1",
        "cmdk": "^1.1.1",
        "fuse.js": "^7.1.0",
        "gray-matter": "^4.0.3",
        "lucide-react": "^0.525.0",
        "motion": "^12.40.0",
        "next": "^15.3.5",
        "next-themes": "^0.4.6",
        "posthog-js": "^1.359.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "reactflow": "^11.11.4",
        "three": "^0.183.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.11.3",
        "@lhci/cli": "^0.15.1",
        "@next/bundle-analyzer": "^15.5.12",
        "@playwright/test": "^1.60.0",
        "@tailwindcss/postcss": "^4.1.11",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "24.0.13",
        "@types/react": "19.1.8",
        "@vitest/coverage-v8": "^4.0.18",
        "autoprefixer": "^10.4.21",
        "cross-env": "^10.1.0",
        "eslint": "^9.39.2",
        "eslint-config-next": "^15.4.1",
        "happy-dom": "^20.9.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.11",
        "typescript": "5.8.3",
        "vitest": "^4.0.18"
    }
}
